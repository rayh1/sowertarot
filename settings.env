# Settings for the skills and tools in this repository: KEY=value lines, read by
# skills/tarot-daily-reading/scripts/daily.py (`daily.py settings` prints them for the shell scripts).
# Put your own values in settings.local.env next to this file (ignored by git); its lines override these.
# A relative path is relative to the repository root.

# Scratch folder that never goes in git (renders in progress, build intermediates).
SOWER_WORK=work

# Daily reading: folder for the cron log, failure logs and the Card of the Day page build (in its page/).
SOWER_DAILY_DIR=work/daily-card

# GitHub account whose gh token pulls and pushes the repository; empty = gh's active account.
SOWER_GH_USER=

# Card of the Day page (a claude.ai Artifact) that the daily reading republishes; empty = no page.
SOWER_PAGE_URL=

# Folder the 07:00 Claude session starts in; the tarot-daily-reading skill must be visible from there.
SOWER_CLAUDE_DIR=.
