# Settings for the skills and tools in this repository: KEY=value lines, read by
# skills/tarot-daily-reading/scripts/daily.py (`daily.py settings` prints them for the shell scripts).
# Put your own values in settings.local.env next to this file (ignored by git); its lines override these.
# A relative path is relative to the repository root.

# Scratch folder that never goes in git (renders in progress, build intermediates).
SOWER_WORK=work

# Daily reading: folder for the cron log, failure logs and the working files of a draw (in its draw/).
SOWER_DAILY_DIR=work/daily-card

# GitHub account whose gh token pulls and pushes the repository; empty = gh's active account.
SOWER_GH_USER=

# rclone destination for backups, e.g. dropbox:Tarot; empty = no backup. The daily reading copies content/ to
# its content/ folder; the card generator copies a card's animation sources that git does not hold
# (tools/animate/batch/<slug>/) to its animations/source/batch/<slug>/. New and changed files only, nothing
# deleted there.
SOWER_BACKUP=

# Card generator: rclone destination (or folder) where candidate renders (in seed-sheets/<slug>/) and clip pilots
# (in animations/procedural/) are put for the user to look at, e.g. dropbox:Tarot; empty = <SOWER_WORK>/review.
SOWER_REVIEW=

# Trigger draws (The Sower or The Miner as the day's card: a new card is due). The 07:00 job announces each once.
# Joplin notebook (joplink) for a note per trigger draw, e.g. Parked; empty = no note (a notified-<date> file in
# SOWER_DAILY_DIR marks the draw as announced instead).
SOWER_PARKED=
# Email: the recipient, and the command that sends a Markdown file (send-mail's options: --to, --subject,
# --markdown, --allow-domain, --allow-link, --dry-run); either empty = no email.
SOWER_NOTIFY_TO=
SOWER_MAIL_COMMAND=

# Folder the 07:00 Claude session starts in; the tarot-daily-reading skill must be visible from there.
SOWER_CLAUDE_DIR=.
