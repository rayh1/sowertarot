---
import "@fontsource/im-fell-english/400.css";
import "@fontsource/im-fell-english/400-italic.css";
import "@fontsource/eb-garamond/400.css";
import "@fontsource/eb-garamond/400-italic.css";
import "@fontsource/eb-garamond/600.css";
import "@fontsource/cormorant-garamond/300.css";
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/400-italic.css";
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title?: string;
  description?: string;
  // Link preview: a picture under /og/ (src/integrations/derived.mjs) and its text.
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
}

const {
  title,
  description = "A 37-card tarot deck in woodcut style, and one card drawn every morning.",
  image = "/og/deck.jpg",
  imageAlt = "Five cards of the Sower Tarot deck side by side.",
  type = "website",
} = Astro.props;
const fullTitle = title ? `${title} · Sower Tarot` : "Sower Tarot";
const path = Astro.url.pathname;
const pageUrl = new URL(path, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const nav = [
  ["/", "Today"],
  ["/cards/", "The deck"],
  ["/readings/", "Readings"],
  ["/news/", "News"],
  ["/about/", "About"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Sower Tarot" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? "Sower Tarot"} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Sower Tarot" href="/rss.xml" />
    <script is:inline>
      // Light or dark before first paint: the stored choice of the sun/moon button, else the system.
      (function () {
        var t = null;
        try {
          t = localStorage.getItem("sower-theme");
        } catch (e) {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/">Sower Tarot</a>
      <nav aria-label="Main">
        {
          nav.map(([href, label]) => (
            <a href={href} aria-current={(href === "/" ? path === "/" : path.startsWith(href)) ? "page" : undefined}>
              {label}
            </a>
          ))
        }
        <ThemeToggle />
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Cards and texts <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a>, code MIT. Sower Tarot.
      </p>
    </footer>
  </body>
</html>
